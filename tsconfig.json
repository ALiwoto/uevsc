{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2022"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "useUnknownInCatchVariables": true,
        "skipLibCheck": true,
        "types": ["node", "vscode"],
        "rootDir": "."
    },
    "include": ["src/**/*.ts", "scripts/**/*.mjs"]
}
